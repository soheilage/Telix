# Copy to terraform.tfvars and edit.
project_id = "telix-ge-workshop"

# Google Group (preferred) or individual users who will attend.
participants = [
  "group:ge-workshop@telix.com",
]

# Region. The Telix workshop is EU-resident: Gemini Enterprise in the `eu` multi-region
# and the bucket in `EU`. These are already the defaults; shown here for clarity.
location        = "eu"
bucket_location = "EU"

# Optional overrides
# bucket_name      = "telix-ge-workshop-data"
# participant_role = "roles/discoveryengine.user"   # if facilitator pre-connects Drive/Calendar
# run_preflight    = false                           # after the one-time check has passed
